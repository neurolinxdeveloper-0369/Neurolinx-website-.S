# Neurolinx environment placeholders — copy to .env and fill locally.
# NEVER commit real secrets.

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/neurolinx
DATABASE_USERNAME=neurolinx
DATABASE_PASSWORD=neurolinx

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- API ---
SERVER_PORT=8080
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Frontend / Admin (also see frontend/.env.example and admin/.env.example) ---
VITE_API_BASE_URL=

# --- Auth (JWT) ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800

# --- Storage ---
STORAGE_URL=
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./media

# --- Payment (provider TBD) ---
PAYMENT_PROVIDER=
PAYMENT_KEY=
PAYMENT_SECRET=
